# PulsePay Phase 1 MVP deployment variables.
# Copy these values into each Railway service instead of committing a real .env file.

# Railway usually provides PORT automatically. SERVER_PORT is optional because
# application.yml falls back to PORT, then the local service defaults.
# SERVER_PORT=8082

# Shared by payment-service and ledger-service.
SPRING_KAFKA_BOOTSTRAP_SERVERS=pkc-xxxxx.region.provider.confluent.cloud:9092
SPRING_KAFKA_SECURITY_PROTOCOL=SASL_SSL
SPRING_KAFKA_SASL_MECHANISM=PLAIN
SPRING_KAFKA_SASL_JAAS_CONFIG=org.apache.kafka.common.security.plain.PlainLoginModule required username="CONFLUENT_API_KEY" password="CONFLUENT_API_SECRET";

# payment-service only. Add the deployed frontend URL after it exists.
PULSEPAY_CORS_ALLOWED_ORIGINS=http://localhost:3000,https://your-pulsepay-frontend.example.com

# Optional frontend variable if deploying pulsepay-frontend.
NEXT_PUBLIC_API_BASE_URL=https://your-payment-service.up.railway.app
